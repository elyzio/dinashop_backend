DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Canonical public storefront origin used by sitemap.xml.
# Production: https://dinashopdash.vercel.app
PUBLIC_STOREFRONT_URL=http://localhost:5173

# Data source selection. This chooses the database and media storage together.
# Use local by default. Set supabase when developing against shared Supabase
# PostgreSQL and Supabase Storage, or in production.
DJANGO_DATA_MODE=local

# Local mode: PostgreSQL + local media/ filesystem.
# sslmode=disable is correct for a normal local PostgreSQL server.
LOCAL_DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:5432/dinashop?sslmode=disable

# DJANGO_DATA_MODE=supabase
# SUPABASE_DATABASE_URL=postgresql://...
# Keep the existing SUPABASE_S3_* and SUPABASE_MEDIA_DOMAIN variables too.

# Supabase mode: PostgreSQL + Supabase Storage. Keep this URL private.
# Use your Supabase pooler/direct connection string with sslmode=require.
# SUPABASE_DATABASE_URL=postgresql://postgres.project-ref:replace-with-password@aws-region.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_S3_ACCESS_KEY_ID=replace-with-supabase-s3-access-key
# SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-supabase-s3-secret-key
# SUPABASE_STORAGE_BUCKET=product-image
# SUPABASE_S3_REGION=replace-with-supabase-region
# SUPABASE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
# The media bucket must be public for the public catalog image URLs.
# Do not include https://. Include the public object path and bucket name.
# SUPABASE_MEDIA_DOMAIN=your-project.supabase.co/storage/v1/object/public/product-image

# Optional: the default is 60 locally and 0 in production/serverless.
# DJANGO_DB_CONN_MAX_AGE=60
BUSINESS_TIMEZONE=UTC

# Authentication
DJANGO_SESSION_COOKIE_AGE=43200
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Local HTTP development values. Set all three to true in production.
DJANGO_SESSION_COOKIE_SECURE=false
# Outbound email is currently disabled with Django's dummy email backend.
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false

# Enable only when Django is behind a trusted HTTPS reverse proxy.
DJANGO_BEHIND_HTTPS_PROXY=false

# Production-only recommendations:
# DJANGO_COOKIE_SAMESITE=Lax
# DJANGO_SECURE_HSTS_SECONDS=31536000
# JWT_SIGNING_KEY=use-a-separate-long-random-production-secret
