DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=dinashop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
BUSINESS_TIMEZONE=UTC

# Authentication
DJANGO_SESSION_COOKIE_AGE=43200
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Local HTTP development values. Set all three to true in production.
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false

# Enable only when Django is behind a trusted HTTPS reverse proxy.
DJANGO_BEHIND_HTTPS_PROXY=false

# Production-only recommendations:
# DJANGO_COOKIE_SAMESITE=Lax
# DJANGO_SECURE_HSTS_SECONDS=31536000
# JWT_SIGNING_KEY=use-a-separate-long-random-production-secret
# SUPABASE_S3_ACCESS_KEY_ID=replace-with-supabase-s3-access-key
# SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-supabase-s3-secret-key
# SUPABASE_STORAGE_BUCKET=product-images
# SUPABASE_S3_REGION=replace-with-your-supabase-region
# SUPABASE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
# SUPABASE_MEDIA_DOMAIN=your-public-media-domain.example.com
